# Desarrollo local: copiar a .env y llenar. En producción estas variables se capturan
# en Vercel (Project → Settings → Environment Variables). El .env NUNCA se sube a git.

# Local: la que imprime `npm run db:local`.
# Vercel: postgres://USUARIO:PASSWORD@IP_DEL_VPS:PUERTO_EXPUESTO/cotizador
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Generar con PowerShell:
# $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
BETTER_AUTH_SECRET=

# Local: http://localhost:3000. En Vercel es opcional (se usa el dominio de producción del proyecto).
BETTER_AUTH_URL=http://localhost:3000

# Opcional: conexiones por instancia (por defecto 3 en Vercel, 10 en local)
# DB_POOL_MAX=3

# --- Fases posteriores ---
GEMINI_API_KEY=
GEMINI_MODEL=
