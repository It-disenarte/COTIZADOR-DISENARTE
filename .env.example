# Desarrollo local: copiar a .env y llenar. En producción estas variables se capturan
# en Vercel (Project → Settings → Environment Variables). El .env NUNCA se sube a git.

# Local: la que imprime `npm run db:local`.
# Vercel: postgres://USUARIO:PASSWORD@IP_DEL_VPS:PUERTO_EXPUESTO/cotizador
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Generar con PowerShell:
# $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
BETTER_AUTH_SECRET=

# Local: http://localhost:3000. En Vercel es opcional (se usa el dominio de producción del proyecto).
BETTER_AUTH_URL=http://localhost:3000

# Opcional: conexiones por instancia (por defecto 3 en Vercel, 10 en local)
# DB_POOL_MAX=3

# --- IA (Gemini) ---
# Llave de https://aistudio.google.com/apikey. Sin ella la app funciona igual; los botones de IA avisan.
GEMINI_API_KEY=
# Opcional. Por defecto gemini-3.8-flash (el Flash estable vigente en sept. 2026).
# GEMINI_MODEL=gemini-3.8-flash
# Opcional. Consultas por usuario por hora (30 por defecto).
# GEMINI_LIMITE_HORA=30

# --- Mapas (OpenStreetMap, sin cuenta ni llave) ---
# Recomendada: coordenadas exactas del taller, "latitud,longitud" (en Google Maps: clic derecho sobre el taller
# y copiar las coordenadas). Sin ella se busca la dirección del taller y la salida puede quedar aproximada.
# ORIGEN_COORDENADAS=20.38,-99.99
# Opcional: sitio o correo de contacto que se envía en el User-Agent, como pide la política de uso de OpenStreetMap.
# CONTACTO_MAPAS=https://www.disenartemx.com
