# Desarrollo local: copiar a .env y llenar. En el VPS estas variables se capturan
# en Easypanel (servicio de la app → Environment). El .env NUNCA se sube a git.

# Local: la que imprime `npm run db:local`.
# VPS: la "Internal Connection URL" del servicio Postgres en Easypanel.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 · VPS: el dominio final con https://
BETTER_AUTH_URL=http://localhost:3000

# Cuenta admin inicial: se crea una sola vez y obliga a cambiar la contraseña al entrar.
# Contraseña temporal de mínimo 10 caracteres.
ADMIN_EMAIL=
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=

# --- Fases posteriores ---
GEMINI_API_KEY=
GEMINI_MODEL=
PDF_STORAGE_PATH=/data/pdfs
